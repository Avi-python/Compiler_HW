# Compiler and tools
CC = gcc
CFLAGS = -Wall -g
LDFLAGS = 
BISON = bison
FLEX = flex

# Source files (as provided by the user)
# Assuming parser.c is the Bison grammar file and scanner.c is the Flex lexical analyzer file.
BISON_SRC = parser.y
FLEX_SRC = scanner.l

# Generated files
PARSER_C_OUT = parser.tab.c
PARSER_H_OUT = parser.tab.h
SCANNER_C_OUT = lex.yy.c

# Target executable
TARGET = compiler

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(PARSER_C_OUT) $(SCANNER_C_OUT)
	$(CC) $(CFLAGS) $(PARSER_C_OUT) $(SCANNER_C_OUT) -o $(TARGET) $(LDFLAGS)

# Rule to generate C source and header from Bison grammar
# The -d flag tells Bison to generate the header file (parser.tab.h)
# The -o flag specifies the output C file name
$(PARSER_C_OUT) $(PARSER_H_OUT): $(BISON_SRC)
	$(BISON) -d -o $(PARSER_C_OUT) $(BISON_SRC)

# Rule to generate C source from Flex scanner
# This depends on the header file generated by Bison
$(SCANNER_C_OUT): $(FLEX_SRC) $(PARSER_H_OUT)
	$(FLEX) -o $(SCANNER_C_OUT) $(FLEX_SRC)

clean:
	rm -f $(TARGET) $(PARSER_C_OUT) $(PARSER_H_OUT) $(SCANNER_C_OUT) *.o
