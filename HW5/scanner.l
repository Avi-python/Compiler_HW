%option yylineno

%{
#include <stdio.h>
#include <string.h> // For strdup
// Include the header file generated by Bison.
// If your Bison input file is 'parser.c', and you use 'bison -d parser.c -o parser.tab.c',
// then the header will be 'parser.tab.h'.
// Adjust if your Bison output/header names differ.
#include "parser.tab.h" // Assuming Bison generates parser.tab.h

int yycolumn = 1;

#define YY_USER_ACTION \
    yylloc.first_line = yylloc.last_line = yylineno; \
    yylloc.first_column = yycolumn; \
    yylloc.last_column = yycolumn + yyleng - 1; \
    yycolumn += yyleng;

// It's good practice to declare yylval if it's not implicitly declared by Bison's header.
// However, parser.tab.h should define it.
// extern YYSTYPE yylval; 
%}

/* Flex definitions */
DIGIT    [0-9]
ALPHA    [a-zA-Z]
ID       {ALPHA}({ALPHA}|{DIGIT})*
NUMBER   {DIGIT}+

/* For multi-line comments */
%x COMMENT

%%

"void"            { return VOID; }
"main"            { return MAIN; }
"int"             { return INT; }
"if"              { return IF; }
"while"           { return WHILE; }

{ID}              { yylval.sval = strdup(yytext); return IDENTIFIER; }
{NUMBER}          { yylval.ival = atoi(yytext); return NUMBER; }

"="               { return ASSIGN; }
"+"               { return PLUS; }
"-"               { return MINUS; }
"*"               { return MULTIPLY; }
"/"               { return DIVIDE; }

"<"               { return LT; }
"<="              { return LE; }
"=="              { return EQ; }
"!="              { return NE; }
">"               { return GT; }
">="              { return GE; }

"("               { return LPAREN; }
")"               { return RPAREN; }
"{"               { return LBRACE; }
"}"               { return RBRACE; }
","               { return COMMA; }
";"               { return SEMICOLON; }

[ \t\r]+          { /* Skip whitespace except newline for line counting if needed */ }
\n                { yycolumn = 1; }

"//"/[^\n]*       { /* Skip single-line comments */ }

"/*"              { BEGIN(COMMENT); /* Enter COMMENT start condition */ }
<COMMENT>"*/"     { BEGIN(INITIAL); /* Exit COMMENT start condition */ }
<COMMENT>[^*\n]+  { /* Eat characters in comment, but not '*' or newline */ }
<COMMENT>"*"      { /* Eat '*' in comment, not followed by '/' */ }
<COMMENT>\n       { /* Eat newline in comment, yylineno++; if counting lines */ }


.                 { fprintf(stderr, "Lexical error: Unexpected character '%c'\n", *yytext); /* Or return an ERROR token */ }

%%

int yywrap(void) {
    return 1; // Indicate that there are no more files to scan
}

// If the parser.c does not have a main, or if you want to test the scanner independently,
// you can uncomment the following main function.
// However, ensure only one main function exists when linking parser and scanner.
